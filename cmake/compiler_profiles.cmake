function(_fleur_flag_var_name lang flag outvar)
  string(REGEX REPLACE "^-+" "" _tmp "${flag}")
  string(REGEX REPLACE "[^A-Za-z0-9]" "_" _tmp "${_tmp}")
  string(TOUPPER "${_tmp}" _tmp)
  if (lang STREQUAL "Fortran")
    set(${outvar} "FLEUR_HAVE_FC_FLAG_${_tmp}" PARENT_SCOPE)
  else()
    set(${outvar} "FLEUR_HAVE_CC_FLAG_${_tmp}" PARENT_SCOPE)
  endif()
endfunction()

function(_fleur_test_and_collect lang flag selected_var available_var)
  _fleur_flag_var_name("${lang}" "${flag}" _cache_var)

  if (NOT DEFINED ${_cache_var})
    if (lang STREQUAL "Fortran")
      check_fortran_compiler_flag("${flag}" ${_cache_var})
    else()
      check_c_compiler_flag("${flag}" ${_cache_var})
    endif()
    set(${_cache_var} "${${_cache_var}}" CACHE BOOL "Compiler support for ${lang} flag ${flag}" FORCE)
  endif()

  if (${_cache_var})
    set(_selected "${${selected_var}}")
    if (_selected)
      set(_selected "${_selected} ${flag}")
    else()
      set(_selected "${flag}")
    endif()
    set(${selected_var} "${_selected}" PARENT_SCOPE)
  endif()

  set(_available "${${available_var}}")
  if (_available)
    set(_available "${_available};${flag}=${${_cache_var}}")
  else()
    set(_available "${flag}=${${_cache_var}}")
  endif()
  set(${available_var} "${_available}" PARENT_SCOPE)
endfunction()

