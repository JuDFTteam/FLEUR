set(_fleur_elpa_kernel_downgrade 0)
if (FLEUR_ELPA_KERNEL_MODE STREQUAL "avx2")
  if ((NOT FLEUR_FORTRAN_ARCH_FLAGS_SELECTED MATCHES "avx2|x86-64-v3|znver2|znver3|znver4|haswell") OR
      (NOT FLEUR_C_ARCH_FLAGS_SELECTED MATCHES "avx2|x86-64-v3|znver2|znver3|znver4|haswell"))
    _fleur_profile_issue("ELPA kernel mode 'avx2' requested but selected Fortran/C architecture flags do not both indicate AVX2 support. Falling back to generic ELPA kernels.")
    set(_fleur_elpa_kernel_downgrade 1)
  endif()
  if (FLEUR_ARCH_FAMILY STREQUAL "x86_64" AND NOT FLEUR_HOST_X86_AVX2)
    _fleur_profile_issue("ELPA kernel mode 'avx2' requested but host CPU does not report AVX2 support. Falling back to generic ELPA kernels.")
    set(_fleur_elpa_kernel_downgrade 1)
  endif()
elseif (FLEUR_ELPA_KERNEL_MODE STREQUAL "avx512")
  if ((NOT FLEUR_FORTRAN_ARCH_FLAGS_SELECTED MATCHES "avx512|x86-64-v4") OR
      (NOT FLEUR_C_ARCH_FLAGS_SELECTED MATCHES "avx512|x86-64-v4"))
    _fleur_profile_issue("ELPA kernel mode 'avx512' requested but selected Fortran/C architecture flags do not both indicate AVX512 support. Falling back to generic ELPA kernels.")
    set(_fleur_elpa_kernel_downgrade 1)
  endif()
  if (FLEUR_ARCH_FAMILY STREQUAL "x86_64" AND NOT FLEUR_HOST_X86_AVX512)
    _fleur_profile_issue("ELPA kernel mode 'avx512' requested but host CPU does not report AVX512F support. Falling back to generic ELPA kernels.")
    set(_fleur_elpa_kernel_downgrade 1)
  endif()
