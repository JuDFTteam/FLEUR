set(FLEUR_HOST_X86_AVX2 OFF)
set(FLEUR_HOST_X86_AVX512 OFF)
if (FLEUR_ARCH_FAMILY STREQUAL "x86_64")
  set(_fleur_cpu_feature_text "")
  if (APPLE)
    execute_process(COMMAND sysctl -n machdep.cpu.features
      OUTPUT_VARIABLE _fleur_cpu_feat_a
      ERROR_QUIET OUTPUT_STRIP_TRAILING_WHITESPACE)
    execute_process(COMMAND sysctl -n machdep.cpu.leaf7_features
      OUTPUT_VARIABLE _fleur_cpu_feat_b
      ERROR_QUIET OUTPUT_STRIP_TRAILING_WHITESPACE)
    set(_fleur_cpu_feature_text "${_fleur_cpu_feat_a} ${_fleur_cpu_feat_b}")
  elseif (EXISTS "/proc/cpuinfo")
    file(READ "/proc/cpuinfo" _fleur_cpu_feature_text)
  endif()

  string(TOLOWER "${_fleur_cpu_feature_text}" _fleur_cpu_feature_text)
  if (_fleur_cpu_feature_text MATCHES "(^|[ ,\n\t])avx2([ ,\n\t]|$)")
    set(FLEUR_HOST_X86_AVX2 ON)
  endif()
  if (_fleur_cpu_feature_text MATCHES "(^|[ ,\n\t])avx512f([ ,\n\t]|$)")
    set(FLEUR_HOST_X86_AVX512 ON)
  endif()
endif()

function(_fleur_profile_issue msg)
  if (FLEUR_STRICT_ARCH_FLAGS)
    message(FATAL_ERROR "${msg}")
  else()
    message(WARNING "${msg}")
  endif()
endfunction()

