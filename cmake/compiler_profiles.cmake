  if (NOT FLEUR_ARCH_FAMILY STREQUAL "aarch64")
    _fleur_profile_issue("ELPA kernel mode 'arm' requested but detected architecture family is '${FLEUR_ARCH_FAMILY}'. Falling back to generic ELPA kernels.")
    set(_fleur_elpa_kernel_downgrade 1)
  endif()
